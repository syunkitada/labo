{%- for interface in spec.vars.ovs_external_bridge.interfaces %}


{%- set bgp_interface = "bgp{}".format(loop.index0) %}
{%- set interface_name = "{}-{}".format(spec.vars.ovs_external_bridge.name, bgp_interface) %}

{#- linklocalのbgp用の通信のingress #}
priority=800,ipv6,in_port={{ interface.name }},ipv6_src=fe80::/10,ipv6_dst=fe80::/10 actions=output:{{ interface_name }}
priority=800,ipv6,in_port={{ interface.name }},ipv6_dst=ff02::/16 actions=output:{{ interface_name }}

{#- linklocalのbgp用の通信のegress #}
priority=800,ipv6,in_port={{ interface_name }},ipv6_src=fe80::/10,ipv6_dst=fe80::/10 actions=output:{{ interface.name }}
priority=800,ipv6,in_port={{ interface_name }},ipv6_dst=ff02::/16 actions=output:{{ interface.name }}

{%- endfor %}

{#- LOCAL #}
{#-
# in_portからARP要求(arp_op=1)が飛んできたときに、ARP_DUMMY_MACを返却します
# arp_op = NXM_OF_ARP_OP = Opcode of ARP, リクエストは1、リプライは2 をセットします
# NXM_OF_ETH_SRC = Ethernet Source address
# NXM_OF_ETH_DST = Ethernet Destination address
# NXM_NX_ARP_SHA = ARP Source Hardware(Ethernet) Address
# NXM_NX_ARP_THA = ARP Target Hardware(Ethernet) Address
# NXM_OF_ARP_SPA = ARP Source IP Address
# NXM_OF_ARP_TPA = ARP Target IP Address
#}
{%- set ARP_DUMMY_MAC = "0x00163e000001" %}
{%- set tmpflow = "priority=800,in_port={},arp,arp_op=1 actions".format("LOCAL") %}
{#- NXM_OF_ETH_SRCをNXM_OF_ETH_DSTにセットして、ARP_DUMMY_MACをNXM_OF_ETH_SRCにセットする #}
{%- set tmpflow = tmpflow + "=move:NXM_OF_ETH_SRC[]->NXM_OF_ETH_DST[],load:{}->NXM_OF_ETH_SRC[]".format(ARP_DUMMY_MAC) %}
{# NXM_NX_ARP_SHAをNXM_NX_ARP_THAにセットして、ARP_DUMMY_MACをNXM_NX_ARP_SHAにセットする #}
{%- set tmpflow = tmpflow + ",move:NXM_NX_ARP_SHA[]->NXM_NX_ARP_THA[],load:{}->NXM_NX_ARP_SHA[]".format(ARP_DUMMY_MAC) %}
{#- NXM_OF_ARP_SPAとNXM_OF_ARP_TPAを入れ替える #}
{%- set tmpflow = tmpflow + ",push:NXM_OF_ARP_TPA[],move:NXM_OF_ARP_SPA[]->NXM_OF_ARP_TPA[],pop:NXM_OF_ARP_SPA[]" %}
{#- Opcodeを2にセットする(ARPのリプライであることを示すフラグ) #}
{%- set tmpflow = tmpflow + ",load:0x2->NXM_OF_ARP_OP[]" %}
{#- IN_PORTにそのまま返す #}
{%- set tmpflow = tmpflow + ",IN_PORT" %}
{{- tmpflow }}

{#- Add flows for EIP #}
{%- for bridge in spec.vars.get("ovs_vxlan_bridges", []) %}
{%- set ex_to_br = "{}_{}".format(spec.vars.ovs_external_bridge.name, bridge.name) %}
{%- set br_to_ex = "{}_{}".format(bridge.name, spec.vars.ovs_external_bridge.name) %}
{%- for port in bridge.get("ports", []) %}
{%- for ip in port.get("ips", []) %}
{%- if "eip" in ip %}
priority=700,ip,nw_dst={{ ip.eip }} actions=output:{{ ex_to_br }}
priority=700,ip,nw_src={{ ip.eip }} actions=group:1
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endfor %}

{#- egress from LOCAL #}
priority=750,ip,nw_dst={{ spec.vars.ovs_external_bridge.local_ip }} actions=mod_dl_dst:@external_bridge_mac,LOCAL
priority=750,ip,in_port=LOCAL,nw_src={{ spec.vars.ovs_external_bridge.local_ip }} actions=group:1

priority=0,actions=drop